{
  "name": "fastschema-dashboard",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:api": "cd .. && go run ./cmd start .",
    "dev:demo": "cd .. && go run ./examples/relations",
    "dev:stack": "concurrently --kill-others --names api,web --prefix-colors yellow,cyan \"npm:dev:api\" \"npm:dev\"",
    "generate-routes": "tsr generate",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy cookie preferredLanguage baseLocale --emit-ts-declarations --silent",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run i18n:compile && tsc --noEmit",
    "build": "vite build",
    "build:embed": "npm run build && node ./scripts/embed-dashboard.mjs",
    "check:embed": "node ./scripts/check-embedded-dashboard.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run build && npm run check:embed",
    "preview": "vite preview"
  },
  "dependencies": {
    "@douyinfe/semi-icons": "2.102.0",
    "@douyinfe/semi-ui": "2.102.0",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.26",
    "@tanstack/react-start": "1.168.43",
    "concurrently": "10.0.4",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@inlang/paraglide-js": "2.23.2",
    "@playwright/test": "1.62.1",
    "@tanstack/router-cli": "1.167.27",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.10.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
